{
  "name": "journeyguard",
  "version": "0.1.0",
  "description": "Free, open-source monitoring for the journeys that make you money: checkout, sign-up and contact forms. Self-hosted, Playwright-powered, safe by default.",
  "keywords": [
    "monitoring",
    "synthetic-monitoring",
    "uptime",
    "woocommerce",
    "shopify",
    "ecommerce",
    "checkout",
    "playwright",
    "self-hosted",
    "smoke-test"
  ],
  "homepage": "https://github.com/nxdpro/journeyguard#readme",
  "bugs": "https://github.com/nxdpro/journeyguard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxdpro/journeyguard.git"
  },
  "license": "MIT",
  "author": "NXDPRO Solutions (https://www.nxdpro.com)",
  "type": "module",
  "bin": {
    "journeyguard": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "demo": "npm run build && node dist/src/bin.js demo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "nodemailer": "^10.1.7",
    "playwright": "1.64.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
